# Keep the build context to what the image actually needs.
# Without this, `docker build` uploads the 400 MB virtualenv and every output
# on each build.
.venv/
__pycache__/
**/__pycache__/
*.pyc
outputs/
logs/
tests/
legacy/
data/processed/
data/raw/*.csv
# research artifacts are not part of any image
reassessment/runs/
reassessment/input/
reassessment/*.json
reassessment/*.md
reassessment/requirements.txt
reassessment/__pycache__/
.env
.env.*
*.xlsx
*.png
*.svg
